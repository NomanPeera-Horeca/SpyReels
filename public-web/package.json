{
  "name": "spyreels-public-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:visual": "PLAYWRIGHT_VISUAL=1 playwright test e2e/visual.spec.ts --project=desktop-1440 --project=mobile-390",
    "test:visual:update": "PLAYWRIGHT_VISUAL=1 playwright test e2e/visual.spec.ts --project=desktop-1440 --project=mobile-390 --update-snapshots",
    "test:visual:docker": "bash scripts/visual-docker.sh test",
    "test:visual:update:docker": "bash scripts/visual-docker.sh update",
    "test:seo": "PLAYWRIGHT_SEO=1 playwright test e2e/seo-contract.spec.ts --project=desktop-1440",
    "test:seo:update": "UPDATE_SEO_BASELINES=1 playwright test e2e/seo-update.spec.ts --project=desktop-1440",
    "test:seo:smoke": "node scripts/production-seo-smoke.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "posthog-js": "1.396.3",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.7.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.4.1"
}
