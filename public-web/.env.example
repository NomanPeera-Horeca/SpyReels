# Public web runtime only. Never commit real secret values.

# Existing SpyReels app/API origin used for Research handoff and curated demo data.
NEXT_PUBLIC_SPYREELS_APP_ORIGIN=https://spyreels.ai
SPYREELS_APP_ORIGIN=https://spyreels.ai

# Reuse the same PostHog project as the existing SpyReels web app.
# Copy the current Render value of VITE_PUBLIC_POSTHOG_TOKEN into this Next name.
# NEXT_PUBLIC_ values are inlined at `next build` time, so set this before building.
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
