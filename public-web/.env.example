# Public web runtime only. Never commit real secret values.

# Existing SpyReels app/API origin used for Research handoff and curated demo data.
# When the host split is live, point these at https://app.spyreels.ai
NEXT_PUBLIC_SPYREELS_APP_ORIGIN=https://spyreels.ai
SPYREELS_APP_ORIGIN=https://spyreels.ai

# Host split: marketing on apex, product + OAuth on app.spyreels.ai.
# Keep false until DNS + Render domain + Google OAuth redirect are ready.
NEXT_PUBLIC_SPYREELS_APP_HOST_SPLIT=false
SPYREELS_APP_HOST_SPLIT=false

# Reuse the same PostHog project as the existing SpyReels web app.
# Copy the current Render value of VITE_PUBLIC_POSTHOG_TOKEN into this Next name.
# NEXT_PUBLIC_ values are inlined at `next build` time, so set this before building.
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side only. Leave false on preview. Production indexing also requires
# an approved spyreels.ai host. Do not use NEXT_PUBLIC_ for this flag.
SPYREELS_PUBLIC_WEB_INDEXING_ENABLED=false
