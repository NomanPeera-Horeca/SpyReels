# Public web runtime only. Never commit real secret values.

# Existing SpyReels app/API origin used for Research handoff and curated demo data.
NEXT_PUBLIC_SPYREELS_APP_ORIGIN=https://spyreels.ai
SPYREELS_APP_ORIGIN=https://spyreels.ai

# Reuse the same PostHog project token/host as the existing SpyReels web app so
# pageviews remain in one analytics project. The phc_ token is a public client key.
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
