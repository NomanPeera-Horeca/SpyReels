# Copy to `.env` and fill in values. Never commit real secrets.

DATABASE_URL=

# Local testing: skip Stripe plan limits (development only; never set in production)
LOCAL_DEV_UNLIMITED_USAGE=

# Single-owner admin panel (must match Google/email login identity)
ADMIN_EMAIL=

# Same email for client-side route guard (Vite exposes this to the browser)
VITE_ADMIN_EMAIL=

# Resend webhooks (Svix signing secret from Resend dashboard)
RESEND_WEBHOOK_SECRET=

# Instagram reel metadata (Collected Reels on-the-go ingest)
SCRAPECREATORS_API_KEY=
# Optional: Google search for Quora + broader web audience questions (Reddit works without this)
SERPER_API_KEY=
TELEGRAM_BOT_TOKEN=

# Discovery V1 (defaults: true in dev, false in production if unset)
DISCOVERY_V1_ENABLED=

# PostHog analytics (client; phc_ project API key)
VITE_PUBLIC_POSTHOG_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Microsoft Clarity (client; project id from clarity.microsoft.com)
VITE_PUBLIC_CLARITY_PROJECT_ID=

# LogRocket (client; app id like org/project from app.logrocket.com)
VITE_PUBLIC_LOGROCKET_APP_ID=

# PostHog error tracking source maps (production build only)
# Personal API key with error tracking write access (not the phc_ project token)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com

# Mobile app (Capacitor shell loads this origin in the native WebView)
# Production default: https://spyreels.ai
CAPACITOR_SERVER_URL=
# Client API/auth origin when bundled inside Capacitor (defaults to https://spyreels.ai)
VITE_APP_ORIGIN=
