# Copy to `.env` and fill in values. Never commit real secrets.

DATABASE_URL=

# Local testing: skip Stripe plan limits (development only; never set in production)
LOCAL_DEV_UNLIMITED_USAGE=

# Single-owner admin panel (must match Google/email login identity)
ADMIN_EMAIL=

# Same email for client-side route guard (Vite exposes this to the browser)
VITE_ADMIN_EMAIL=

# Authentication signing secret. Generate locally with `pnpm setup:viral-posts-local`.
# Never commit a real value. Production must load this from the platform secret manager.
JWT_SECRET=

# Viral Posts live Instagram feed
# Local/staging recommended values:
VIRAL_POSTS_LIVE=true
VIRAL_POSTS_INSTAGRAM_ENABLED=true
# Keep false on web instances. Enable only in a dedicated worker/cron process.
VIRAL_POSTS_POOL_REFRESHER=false
# 3 hours in milliseconds
VIRAL_POSTS_POOL_REFRESH_MS=10800000

# Resend webhooks (Svix signing secret from Resend dashboard)
RESEND_WEBHOOK_SECRET=

# Instagram reel metadata (Collected Reels on-the-go ingest)
SCRAPECREATORS_API_KEY=
# Optional: Google search for Quora + broader web audience questions (Reddit works without this)
SERPER_API_KEY=
TELEGRAM_BOT_TOKEN=

# Stock B-roll video search (Pexels primary, Pixabay fallback). Same names on Render.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Discovery V1 (defaults: true in dev, false in production if unset)
DISCOVERY_V1_ENABLED=

# Viral Posts Phase 3A (set explicit true/false; do not leave blank in deployed envs)
VIRAL_POSTS_LIVE=true
VIRAL_POSTS_INSTAGRAM_ENABLED=true
# Process-local refresher (local only). Production web: false. Use cron/worker instead.
VIRAL_POSTS_POOL_REFRESHER=true
VIRAL_POSTS_POOL_REFRESH_MS=10800000
# Verbose DB op logs (must be false in production)
VIRAL_POSTS_DB_DEBUG=false
# Optional unique id for pool refresh leases
VIRAL_POSTS_WORKER_ID=

# Public Web v2 pilot routing. Disabled unless BOTH values below are set.
# The current pilot hands /features/viral-reel-finder, its /demo + /profile
# data routes, and /_next/* assets to the isolated Next.js renderer.
# Leave false in production until explicit rollout approval.
SPYREELS_PUBLIC_WEB_PILOT=false
SPYREELS_PUBLIC_WEB_ORIGIN=
SPYREELS_PUBLIC_WEB_TIMEOUT_MS=5000
# Server-side only. Leave false until the production pilot is approved.
SPYREELS_PUBLIC_WEB_INDEXING_ENABLED=false

# PostHog analytics (client; phc_ project API key)
# The Next public-web renderer must reuse this same project via NEXT_PUBLIC_POSTHOG_TOKEN.
VITE_PUBLIC_POSTHOG_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Microsoft Clarity (client; project id from clarity.microsoft.com)
VITE_PUBLIC_CLARITY_PROJECT_ID=

# LogRocket (client; app id like org/project)
VITE_PUBLIC_LOGROCKET_APP_ID=

# Retell website widget (public key + chat agent; marketing pages only)
# Dashboard → Public Keys / Agents. Never put the secret API key here.
VITE_PUBLIC_RETELL_PUBLIC_KEY=
VITE_PUBLIC_RETELL_CHAT_AGENT_ID=
# Optional: enable voice + chat hybrid chooser
VITE_PUBLIC_RETELL_VOICE_AGENT_ID=
VITE_PUBLIC_RETELL_VOICE_PUBLIC_KEY=

# PostHog error tracking source maps (production build only)
# Personal API key with error tracking write access (not the phc_ project token)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com

# Mobile app (Capacitor shell loads this origin in the native WebView)
# Production default: https://spyreels.ai
CAPACITOR_SERVER_URL=
# Client API/auth origin when bundled inside Capacitor (defaults to https://spyreels.ai)
VITE_APP_ORIGIN=
